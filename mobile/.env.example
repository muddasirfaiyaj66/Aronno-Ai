EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Same web client ID as backend GOOGLE_CLIENT_ID. Used on Expo web.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android/iOS OAuth clients. Package and bundle id are app.aronno.mobile.
# After these are set, rebuild the dev client so Google can return to the app.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Online assistant only. Offline chat still uses on-device llama.rn.
# Real keys belong only in mobile/.env. EAS reads that file during the build.
# Do not copy them into eas.json. An empty value there would override .env.
EXPO_PUBLIC_OLLAMA_API_KEY=
EXPO_PUBLIC_OLLAMA_HOST=https://ollama.com
EXPO_PUBLIC_OLLAMA_CHAT_MODEL=gemma4:31b-cloud
# Separate free AI Studio key for the female voice only. Billing must stay off.
# https://aistudio.google.com/apikey — model used is gemini-3.8-flash-lite-tts.
EXPO_PUBLIC_GEMINI_TTS_API_KEY=
