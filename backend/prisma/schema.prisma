generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- Lookups (3NF) ---

model Role {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  slug   String @unique
  nameBn String
  nameEn String
  users  User[]
}

model Profession {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  slug   String @unique
  nameBn String
  nameEn String
  users  User[]
}

model District {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  slug   String @unique
  nameBn String
  users           User[]
  markets         Market[]
  listings        Listing[]
  heatMapStats    HeatMapStat[]
  diagnoses       Diagnosis[]
  shops           Shop[]
  products        Product[]
  orders          Order[]
}

model Crop {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  slug   String @unique
  nameBn String
  nameEn String
  diagnoses         Diagnosis[]
  costEstimates     CostEstimate[]
  fertilizerAdvice  FertilizerAdvice[]
  yieldEstimates    YieldEstimate[]
  marketPrices      MarketPrice[]
  listings          Listing[]
  products          Product[]
}

model LoanPurpose {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  slug   String @unique
  nameBn String
  applications LoanApplication[]
}

// --- Identity ---

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  passwordHash     String?
  googleSub        String?
  displayName      String
  avatarUrl        String?
  phone            String?
  roleId           String    @db.ObjectId
  professionId     String?   @db.ObjectId
  districtId       String?   @db.ObjectId
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  role        Role         @relation(fields: [roleId], references: [id])
  profession  Profession?  @relation(fields: [professionId], references: [id])
  district    District?    @relation(fields: [districtId], references: [id])

  oauthAccounts     OAuthAccount[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  diagnoses         Diagnosis[]
  treatmentPlans    TreatmentPlan[]
  costEstimates     CostEstimate[]
  historyEvents     HistoryEvent[]
  reports           Report[]
  toolIdentifications ToolIdentification[]
  receipts          Receipt[]
  fertilizerAdvice  FertilizerAdvice[]
  yieldEstimates    YieldEstimate[]
  cropPlans         CropPlan[]
  listings          Listing[]
  loanApplications  LoanApplication[]
  emailTokens       EmailToken[]
  chatTurns         ChatTurn[]
  shop              Shop?
  sellerProducts    Product[]         @relation("SellerProducts")
  cart              Cart?
  buyerOrders       Order[]           @relation("BuyerOrders")
  reviews           Review[]
  notifications     Notification[]

  @@index([googleSub])
}

model OAuthAccount {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User   @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  deviceName String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, familyId])
}

enum EmailTokenPurpose {
  verification
  password_reset
}

model EmailToken {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  userId    String            @db.ObjectId
  purpose   EmailTokenPurpose
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId String   @db.ObjectId
  action      String
  target      String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id])
}

// --- Sprint 1: diagnosis ---

enum DiagnosisSource {
  photo
  voice
  offline_photo
  offline_voice
}

enum Severity {
  low
  medium
  high
}

model Diagnosis {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  cropId          String?         @db.ObjectId
  source          DiagnosisSource
  imageObjectKey  String?
  transcriptBn    String?
  diseaseNameBn   String
  diseaseNameEn   String
  confidence      Int
  severity        Severity
  clientLocalId   String?
  offlineLabelId  String?
  verifiedBn      String?
  /// Where the scan happened: district from GPS (nearest centroid) or the
  /// farmer's profile district. Drives the market heat map.
  districtId      String?         @db.ObjectId
  lat             Float?
  lon             Float?
  createdAt       DateTime        @default(now())

  user           User            @relation(fields: [userId], references: [id])
  crop           Crop?           @relation(fields: [cropId], references: [id])
  district       District?       @relation(fields: [districtId], references: [id])
  treatmentPlan  TreatmentPlan?
  reports        Report[]

  @@index([clientLocalId])
  @@index([createdAt, districtId])
}

enum HistoryKind {
  disease
  yield
  loan
}

model HistoryEvent {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  userId     String      @db.ObjectId
  kind       HistoryKind
  sourceId   String
  occurredAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
}

enum ChatRole {
  user
  assistant
}

model ChatTurn {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  clientLocalId  String?
  role           ChatRole
  textBn         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([clientLocalId])
  @@index([userId, createdAt])
}

// --- Sprint 2: treatment + cost ---

enum SprayLevel {
  safe
  caution
  wait
}

enum LandUnit {
  bigha
  acre
}

model TreatmentPlan {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  diagnosisId     String   @unique @db.ObjectId
  userId          String   @db.ObjectId
  pesticideNameBn String
  dosagePerBigha  String
  followUpLabelBn String
  createdAt       DateTime @default(now())

  diagnosis Diagnosis        @relation(fields: [diagnosisId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  weather   WeatherAdvisory?
  steps     TreatmentStep[]
  safety    SafetyItem[]
  reports   Report[]
}

model WeatherAdvisory {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  treatmentPlanId String     @unique @db.ObjectId
  level           SprayLevel
  reasonBn        String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
}

model TreatmentStep {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  treatmentPlanId String @db.ObjectId
  step            Int
  instructionBn   String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])

  @@unique([treatmentPlanId, step])
}

model SafetyItem {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  treatmentPlanId String @db.ObjectId
  labelBn         String
  sortOrder       Int
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
}

model CostEstimate {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  cropId             String   @db.ObjectId
  landSize           Float
  landUnit           LandUnit
  pesticideQuantity  String
  totalCostBdt       Int
  spraySessions      Int
  /// Per-crop cultivation cost (seed, fertilizer, pesticide, labour …).
  cultivationTotalBdt Int?
  breakdown          Json?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  crop               Crop     @relation(fields: [cropId], references: [id])
}

// --- Sprint 3: reports ---

model Report {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  diagnosisId     String   @db.ObjectId
  treatmentPlanId String?  @db.ObjectId
  pdfObjectKey    String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  diagnosis       Diagnosis @relation(fields: [diagnosisId], references: [id])
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
}

// --- Sprint 4: tools + receipts ---

enum CaptureSource {
  photo
  voice
}

model ToolIdentification {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  source         CaptureSource
  imageObjectKey String?
  transcriptBn   String?
  toolNameBn     String
  toolNameEn     String
  reasonBn       String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  listings       ToolListing[]
}

model ToolListing {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  toolIdentificationId String @db.ObjectId
  sourceName           String
  thumbnailUrl         String @default("")
  priceBn              String?
  externalUrl          String
  identification       ToolIdentification @relation(fields: [toolIdentificationId], references: [id])
}

model Receipt {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  userId         String        @db.ObjectId
  imageObjectKey String
  totalBdt       Int
  summaryBn      String
  /// Set once the farmer has checked / corrected the extracted items.
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  items          ReceiptItem[]
}

model ReceiptItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  receiptId  String @db.ObjectId
  nameBn     String
  quantity   String
  priceBn    String
  priceBdt   Int?
  sortOrder  Int
  receipt    Receipt @relation(fields: [receiptId], references: [id])
}

// --- Sprint 5: fertilizer / yield / planning ---

enum GrowthStage {
  seedling
  vegetative
  flowering
  maturity
}

enum SoilColor {
  dark
  medium
  light
}

enum SoilMoisture {
  wet
  moist
  dry
}

enum YieldTrend {
  up
  down
  flat
}

model FertilizerAdvice {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  userId               String       @db.ObjectId
  cropId               String       @db.ObjectId
  growthStage          GrowthStage
  soilColor            SoilColor
  soilMoisture         SoilMoisture
  landSizeBigha        Float?
  cropAgeDays          Int?
  hasDisease           String?
  diseaseNameBn        String?
  fertilizerNameBn     String
  dosagePerBigha       String
  applicationMethodBn  String
  timingBn             String
  warningBn            String?
  reasonBn             String?
  createdAt            DateTime     @default(now())
  user                 User         @relation(fields: [userId], references: [id])
  crop                 Crop         @relation(fields: [cropId], references: [id])
}

model YieldEstimate {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  userId           String     @db.ObjectId
  cropId           String     @db.ObjectId
  landSizeBn       String
  weatherSummaryBn String
  estimatedMinMon  Float
  estimatedMaxMon  Float
  lastSeasonMon    Float
  trend            YieldTrend
  changePercent    Float
  createdAt        DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [id])
  crop             Crop       @relation(fields: [cropId], references: [id])
}

model CropPlan {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  userId           String          @db.ObjectId
  recommendationBn String
  costEstimate     Json?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id])
  months           MonthForecast[]
}

model MonthForecast {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  cropPlanId        String   @db.ObjectId
  monthBn           String
  weatherIcon       String
  recommendedCropBn String
  tempC             Int?
  precipMm          Int?
  cropSlug          String?
  plantingWindowBn  String?
  harvestWindowBn   String?
  reasonBn          String?
  sortOrder         Int
  cropPlan          CropPlan @relation(fields: [cropPlanId], references: [id])

  @@unique([cropPlanId, sortOrder])
}

/// Seasonal outlook cache — survives serverless cold starts (refreshed daily).
model WeatherCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  payload   Json
  fetchedAt DateTime
}

// --- Sprint 6: market + loan ---

model Market {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  nameBn     String
  districtId String        @db.ObjectId
  district   District      @relation(fields: [districtId], references: [id])
  prices     MarketPrice[]
}

model MarketPrice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  marketId    String   @db.ObjectId
  cropId      String   @db.ObjectId
  pricePerMon Int
  capturedAt  DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id])
  crop        Crop     @relation(fields: [cropId], references: [id])

  @@index([marketId, cropId, capturedAt])
}

model Listing {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerUserId        String   @db.ObjectId
  cropId              String   @db.ObjectId
  quantityBn          String
  quantityKg          Int?
  askingPricePerKg    Int
  districtId          String   @db.ObjectId
  thumbnailObjectKey  String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  seller              User     @relation(fields: [sellerUserId], references: [id])
  crop                Crop     @relation(fields: [cropId], references: [id])
  district            District @relation(fields: [districtId], references: [id])
}

model HeatMapStat {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  districtId        String   @db.ObjectId
  diseaseIntensity  Float
  priceIntensity    Float
  capturedAt        DateTime @default(now())
  district          District @relation(fields: [districtId], references: [id])
}

enum LoanStatus {
  pending
  approved
  repaying
  rejected
}

enum RepaymentPeriod {
  THREE_MONTHS
  SIX_MONTHS
  TWELVE_MONTHS
}

model LoanApplication {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  amountBdt       Int
  purposeId       String          @db.ObjectId
  repaymentPeriod RepaymentPeriod
  status          LoanStatus      @default(pending)
  nextPaymentDue  DateTime?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id])
  purpose         LoanPurpose     @relation(fields: [purposeId], references: [id])
}

// ==========================================
// AGRICULTURE MARKETPLACE (Sprint 7)
// ==========================================

enum ProductCategory {
  crops
  vegetables
  fruits
  seeds
  fertilizers
  pesticides
  fish
  dairy
  eggs
  tools
  other
}

enum ProductUnit {
  kg
  mon
  ton
  piece
  liter
  bag
}

enum ProductStatus {
  active
  out_of_stock
  inactive
}

enum ProductGrade {
  premium
  grade_a
  grade_b
  standard
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  cash_on_delivery
  pending
  paid
  failed
}

type CartItem {
  productId  String @db.ObjectId
  quantity   Float
  priceAtAdd Int
}

type ProductImage {
  url      String
  publicId String?
}

type OrderItem {
  productId    String      @db.ObjectId
  productName  String
  unit         ProductUnit
  pricePerUnit Int
  quantity     Float
  totalPrice   Int
  imageUrl     String?
}

model Shop {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerUserId String   @unique @db.ObjectId
  name        String
  description String?
  logoUrl     String?
  bannerUrl   String?
  phone       String
  districtId  String   @db.ObjectId
  upazila     String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerUserId], references: [id])
  district District  @relation(fields: [districtId], references: [id])
  products Product[]
  orders   Order[]

  @@index([districtId])
  @@index([isActive])
}

model Product {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  shopId            String          @db.ObjectId
  sellerUserId      String          @db.ObjectId
  name              String
  category          ProductCategory
  cropId            String?         @db.ObjectId
  description       String
  pricePerUnit      Int
  unit              ProductUnit
  availableQuantity Float
  minOrderQuantity  Float           @default(1)
  images            ProductImage[]
  districtId        String          @db.ObjectId
  status            ProductStatus   @default(active)

  harvestDate       DateTime?
  grade             ProductGrade?
  isOrganic         Boolean         @default(false)

  avgRating         Float           @default(0)
  reviewCount       Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shop     Shop       @relation(fields: [shopId], references: [id])
  seller   User       @relation("SellerProducts", fields: [sellerUserId], references: [id])
  district District   @relation(fields: [districtId], references: [id])
  crop     Crop?      @relation(fields: [cropId], references: [id])
  reviews  Review[]

  @@index([shopId])
  @@index([sellerUserId])
  @@index([category, status])
  @@index([districtId])
  @@index([status, createdAt])
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String        @unique
  buyerUserId     String        @db.ObjectId
  shopId          String        @db.ObjectId
  sellerUserId    String        @db.ObjectId
  items           OrderItem[]
  subtotalBdt     Int
  deliveryFeeBdt  Int           @default(0)
  totalBdt        Int
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(cash_on_delivery)
  /// cash_on_delivery | online | mobile_banking. The charged amount is never taken from the client.
  paymentMethod   String        @default("cash_on_delivery")
  paymentTranId   String?
  paymentValId    String?
  paymentGateway  String?
  paidAt          DateTime?
  shippingAddress String
  contactPhone    String
  districtId      String        @db.ObjectId
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  buyer    User      @relation("BuyerOrders", fields: [buyerUserId], references: [id])
  shop     Shop      @relation(fields: [shopId], references: [id])
  district District  @relation(fields: [districtId], references: [id])
  reviews  Review[]

  @@index([buyerUserId])
  @@index([shopId])
  @@index([sellerUserId])
  @@index([status, createdAt])
  @@index([paymentTranId])
}

/// Rates the admin can change. Same city as the shop, or another city.
model DeliveryRate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  key          String   @unique
  sameCityBdt  Int
  otherCityBdt Int
  updatedAt    DateTime @updatedAt
}

/// Seller withdrawal. The amount is checked against server-side earnings.
model Payout {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  shopId        String   @db.ObjectId
  amountBdt     Int
  channel       String
  accountName   String
  accountNumber String
  bankName      String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// In-app alert delivered over the live socket and the notifications list.
model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  dedupeKey String
  kind      String
  title     String
  body      String
  pathname    String?
  params      Json?
  priority    String?
  popup       Boolean?
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

/// One admin-composed message, fanned out into each recipient's inbox.
model AdminBroadcast {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  body           String
  priority       String
  audience       String
  targetUserId   String?  @db.ObjectId
  districtSlug   String?
  createdById    String   @db.ObjectId
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model SellerReport {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterUserId String   @db.ObjectId
  shopId         String   @db.ObjectId
  sellerUserId   String   @db.ObjectId
  reason         String
  details        String?
  status         String   @default("open")
  action         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([shopId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  orderId   String   @db.ObjectId
  userId    String   @db.ObjectId
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
  @@index([userId])
}
