EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Same web client ID as backend GOOGLE_CLIENT_ID. Used on Expo web.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android/iOS OAuth clients. Package and bundle id are app.aronno.mobile.
# After these are set, rebuild the dev client so Google can return to the app.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Online assistant: Google's free Gemini API (Flash-Lite models, never Pro).
# Make a free key at https://aistudio.google.com/apikey — ideally in its own
# Google project so the app and the backend don't share free limits.
# When set, chat uses Gemini; the Ollama settings below are then unused.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: try this free model first (e.g. gemma-4-31b-it). Pro is ignored.
EXPO_PUBLIC_GEMINI_CHAT_MODEL=
# Fallback online assistant when no Gemini key is set. Offline chat still uses on-device llama.rn.
# Real keys belong only in mobile/.env. EAS reads that file during the build.
# Do not copy them into eas.json. An empty value there would override .env.
EXPO_PUBLIC_OLLAMA_API_KEY=
EXPO_PUBLIC_OLLAMA_HOST=https://ollama.com
EXPO_PUBLIC_OLLAMA_CHAT_MODEL=gemma4:31b-cloud
# Separate free AI Studio key for the female voice only. Billing must stay off.
# https://aistudio.google.com/apikey — model used is gemini-3.8-flash-lite-tts.
EXPO_PUBLIC_GEMINI_TTS_API_KEY=
# Video consult service. Empty until the Azure hostname is ready.
EXPO_PUBLIC_CALL_URL=
