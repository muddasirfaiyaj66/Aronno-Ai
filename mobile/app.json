{
  "expo": {
    "name": "আরণ্য",
    "slug": "aronno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aronno",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "app.aronno.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EA"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "আরণ্যকে ফসলের ছবি তুলে রোগ নির্ণয় করতে ক্যামেরা ব্যবহারের অনুমতি দিন।"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "আরণ্যকে আপনার ক্ষেতের আবহাওয়া দেখাতে অবস্থান ব্যবহারের অনুমতি দিন।"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebe51e56-7ffe-431e-93c5-d363f0d46e01"
      }
    }
  }
}
