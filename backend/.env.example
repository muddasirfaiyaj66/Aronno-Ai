NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:8082,http://localhost:3001,https://aronnoaibd.vercel.app
DATABASE_URL=mongodb://localhost:27017/aronno
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
# Web client ID, plus any Android/iOS client IDs the phone uses. Commas are allowed on GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
THROTTLE_TTL=60
THROTTLE_LIMIT=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TTS_PROVIDER_KEY=
S3_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Aronno <noreply@aronno.local>

# Cloudinary (Secure Backend Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SSLCommerz. Amounts are calculated on the server. Use the sandbox until go-live.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# Public API origin SSLCommerz can call back, with no trailing slash. Example: https://api.example.com
API_PUBLIC_URL=

# Video consult microservice. Leave blank until the Azure VM is up.
CALL_SERVICE_URL=
CALL_SERVICE_SECRET=

